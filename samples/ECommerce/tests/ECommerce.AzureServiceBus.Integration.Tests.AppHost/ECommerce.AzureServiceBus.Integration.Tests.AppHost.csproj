<Project Sdk="Aspire.AppHost.Sdk/13.0.0">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <!-- Security pin: MessagePack arrives transitively via Aspire.Hosting -> StreamJsonRpc.
         The transitive 2.5.192 has a known high-severity vulnerability (CVE-2026-48109,
         GHSA-hv8m-jj95-wg3x). Referenced directly so Central Package Management forces the
         patched 2.5.301. Remove once Aspire.Hosting/StreamJsonRpc flow a patched MessagePack. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <!-- NOTE: Azure Service Bus Emulator references removed -->
  <!-- Service Bus is now managed directly via DirectServiceBusEmulatorFixture (docker-compose) -->
  <!-- to avoid Aspire's OOM issues with emulator orchestration on ARM64 -->

</Project>
