<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <WhizbangTestTags>Unit</WhizbangTestTags>
    <!-- Unit: the shared fixture helpers, driven by fake sources; no hosts, no infrastructure -->
    <WhizbangTestType>Unit</WhizbangTestType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="TUnit.Assertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ECommerce.Integration.TestUtilities\ECommerce.Integration.TestUtilities.csproj" />
    <ProjectReference Include="..\..\..\..\src\Whizbang.Core\Whizbang.Core.csproj" />
  </ItemGroup>

</Project>
