<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Temporarily suppress Guid usage analyzer warnings in sample projects -->
    <!-- Remove after Phase 5 migration completes all usages -->
    <NoWarn>$(NoWarn);WHIZ055;WHIZ056</NoWarn>
    <!-- Suppress the DI-factory construction rule here: fixtures and samples construct
         services by hand on purpose, supplying only what a scenario needs. The rule exists
         for registrations that stand in for the container in shipping code. -->
    <NoWarn>$(NoWarn);WHIZ500</NoWarn>
  </PropertyGroup>
</Project>
