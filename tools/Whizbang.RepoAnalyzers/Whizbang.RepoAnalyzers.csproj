<Project Sdk="Microsoft.NET.Sdk">
  <!-- Analyzers that guard this repository's own source and are never shipped. Directory.Build.props
       loads them into every project as an analyzer. A rule belongs here when the SDK this repository
       builds with cannot enforce it yet; retire it once the SDK can. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Whizbang.RepoAnalyzers</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <!-- Release tracking files are for shipped analyzer packages; these rules never ship. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <PolySharpExcludeTypeForwardedToDeclarations>true</PolySharpExcludeTypeForwardedToDeclarations>
    <!-- Directory.Build.props turns the AOT analyzers on before this file sets netstandard2.0, where they are
         unsupported (NETSDK1210). An analyzer runs inside the compiler, never in a trimmed app. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
