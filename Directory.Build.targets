<Project>
  <!-- The trimming/AOT analyzers add an implicit Microsoft.NET.ILLink.Tasks reference whose version
       follows whichever .NET SDK patch happens to be installed. With committed lock files and
       locked-mode restore, that would make every SDK patch (and every machine on a different one)
       fail restore. Pin it so the lock files record one version everywhere; move it with the SDK. -->
  <ItemGroup>
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks" ILLinkPackVersion="10.0.12" />
  </ItemGroup>

  <!-- C# language version pinned to the one the .NET 10 SDK calls "latest", as AnalysisLevel is (#1678).
       global.json rolls forward to the newest installed SDK, where "latest" means the next language
       version: code written to it does not compile on CI, which builds on SDK 10, and IDE0028 (a build
       error since #1804) asks for that version's collection-expression arguments in place of
       new(comparer), about a hundred findings that exist only on the newer SDK. Set here, after the
       project files, because many of them set LangVersion to latest themselves. Move it when CI moves. -->
  <PropertyGroup Condition="'$(LangVersion)' == 'latest'">
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <!-- Custom task to add retry logic with exponential backoff for file locking issues -->
  <UsingTask TaskName="RetryFileOperation" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <MaxRetries ParameterType="System.Int32" Required="false" />
      <Success ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Threading" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        int maxRetries = MaxRetries > 0 ? MaxRetries : 5;
        int attempt = 0;
        Success = false;

        while (attempt < maxRetries && !Success) {
            attempt++;
            try {
                // Check if file is locked by trying to open it exclusively
                if (File.Exists(FilePath)) {
                    using (var fs = File.Open(FilePath, FileMode.Open, FileAccess.ReadWrite, FileShare.None)) {
                        // File is accessible
                    }
                }
                Success = true;
            } catch (IOException) when (attempt < maxRetries) {
                // File is locked, wait with exponential backoff
                int delayMs = (int)Math.Pow(2, attempt) * 1000; // 2s, 4s, 8s, 16s, 32s
                Log.LogMessage(MessageImportance.High, $"File locked: {FilePath}. Retry {attempt}/{maxRetries} after {delayMs/1000}s...");
                Thread.Sleep(delayMs);
            } catch (IOException ex) when (attempt >= maxRetries) {
                Log.LogError($"File locked after {maxRetries} retries: {FilePath}. Error: {ex.Message}");
                Success = false;
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Override GenerateDepsFile target to add retry logic -->
  <Target Name="_GenerateDepsFileWithRetry" BeforeTargets="GenerateDepsFile">
    <PropertyGroup>
      <!-- Check both intermediate and output paths for file locks -->
      <IntermediateDepsFilePath>$(IntermediateOutputPath)$(TargetName).deps.json</IntermediateDepsFilePath>
      <OutputDepsFilePath>$(OutputPath)$(TargetName).deps.json</OutputDepsFilePath>
    </PropertyGroup>

    <!-- Retry on intermediate path -->
    <RetryFileOperation
      FilePath="$(IntermediateDepsFilePath)"
      MaxRetries="5"
      Condition="Exists('$(IntermediateDepsFilePath)')">
      <Output TaskParameter="Success" PropertyName="IntermediateDepsFileAccessible" />
    </RetryFileOperation>

    <!-- Retry on output path (where the actual lock often occurs) -->
    <RetryFileOperation
      FilePath="$(OutputDepsFilePath)"
      MaxRetries="5"
      Condition="Exists('$(OutputDepsFilePath)')">
      <Output TaskParameter="Success" PropertyName="OutputDepsFileAccessible" />
    </RetryFileOperation>
  </Target>

  <!-- Enable message registry extraction (matches the default set by the NuGet .props for consumers) -->
  <PropertyGroup>
    <WhizbangEmitMessageRegistry Condition="'$(WhizbangEmitMessageRegistry)' == ''">true</WhizbangEmitMessageRegistry>
  </PropertyGroup>

  <!-- Import shared message registry extraction target (also shipped in NuGet package) -->
  <Import Project="src/Whizbang.Generators/build/SoftwareExtravaganza.Whizbang.Generators.targets" />

  <!--
    Every test project must declare WhizbangTestTags.

    The tags are load-bearing, not documentation: scripts/Run-Tests.ps1 selects suites with
    -Tag, and CI's integration jobs are built on that selection (Postgres, RabbitMQ,
    AzureServiceBus, AzureBlob, InMemory). A test project with no tags is invisible to every
    tag-based job — it does not fail, it simply never runs, and CI stays green while the suite
    silently stops being exercised.

    This is an MSBuild check rather than a Roslyn analyzer on purpose: WhizbangTestTags is an
    MSBuild property, so it is not reachable from an analyzer without plumbing it through
    CompilerVisibleProperty, and evaluation-time failure is both simpler and earlier than
    compile-time.
  -->
  <Target Name="ValidateWhizbangTestTags"
          BeforeTargets="Build"
          Condition="'$(IsTestProject)' == 'true' AND '$(WhizbangTestTags)' == ''">
    <Error Code="WHZ0001"
           Text="$(MSBuildProjectName) is a test project (IsTestProject=true) but declares no &lt;WhizbangTestTags&gt;. Tag-based selection (Run-Tests.ps1 -Tag, and the CI integration jobs built on it) would skip it silently. Add a kind tag (Unit, Component or Integration), plus Docker and the infrastructure it needs (Postgres, RabbitMQ, AzureServiceBus, AzureBlob, InMemory) when it uses containers." />
  </Target>

  <!--
    Every test project must declare a WhizbangTestType that every tool knows.

    Run-Tests.ps1, Test-SolutionTestProjects.ps1, the CI build slices and the CI suites all select
    projects by this property, and each one skips a type it does not know without a word: the
    project builds, its tests never run. A test project with no type at all is skipped the same way
    (Whizbang.LanguageServer.Tests ran nowhere until #1264). Adding a type means teaching every reader
    (docs/TEST-PROJECTS.md, "Adding a test type"); .github/scripts/Test-WhizbangTestType.ps1 checks
    that each one knows every type listed here and every type a project declares.
  -->
  <PropertyGroup>
    <WhizbangKnownTestTypes>Unit;Component;Integration;Benchmark;Soak</WhizbangKnownTestTypes>
  </PropertyGroup>
  <Target Name="ValidateWhizbangTestType"
          BeforeTargets="Build"
          Condition="'$(IsTestProject)' == 'true' OR '$(WhizbangTestType)' != ''">
    <Error Code="WHZ0002"
           Condition="'$(WhizbangTestType)' == ''"
           Text="$(MSBuildProjectName) is a test project (IsTestProject=true) but declares no &lt;WhizbangTestType&gt;. Every test runner selects projects by it, so this project's tests would never run. Declare one of: $(WhizbangKnownTestTypes) (docs/TEST-PROJECTS.md)." />
    <Error Code="WHZ0003"
           Condition="'$(WhizbangTestType)' != '' AND !$([System.String]::new(';$(WhizbangKnownTestTypes);').Contains(';$(WhizbangTestType);'))"
           Text="$(MSBuildProjectName) declares &lt;WhizbangTestType&gt;$(WhizbangTestType)&lt;/WhizbangTestType&gt;, which no test runner knows, so its tests would never run. Use one of: $(WhizbangKnownTestTypes), or add the type to every reader (docs/TEST-PROJECTS.md, &quot;Adding a test type&quot;)." />
  </Target>

  <!-- Public API compatibility (#1439). Packing a library compares it with the last stable release on
       nuget.org and fails on any change that breaks binary or source compatibility (a removed or changed
       public member, a narrowed framework), unless the break is recorded as intended in the project's
       CompatibilitySuppressions.xml, which a pull request then shows a reviewer. Set here, not in
       Directory.Build.props, because IncludeBuildOutput and PackAsTool are set in the project file:
       analyzer and generator packages ship no library to compare, and the command-line tools are not
       an API. After each stable release, move the baseline to it and delete the suppression files
       (docs/RELEASING.md, "Public API baseline"). Pre-1.0 every release is a minor, so a break is
       allowed; it is the record that matters. On CI only, or when WhizbangApiCheck is true: a local
       pack carries the placeholder version from Directory.Build.props, lower than any release, and
       the check would report that as an assembly identity change (CP0003) in every package. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(IncludeBuildOutput)' != 'false' and '$(PackAsTool)' != 'true' and ('$(CI)' == 'true' or '$(WhizbangApiCheck)' == 'true')">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion Condition="'$(WhizbangUnreleasedPackage)' != 'true'">0.2625.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <!-- A package with no stable release yet (WhizbangUnreleasedPackage=true in its project file) has no baseline on
       nuget.org to download, so restore would fail (NU1101). It is still validated, against itself; after its first
       stable release, delete the property so it is compared like every other package (docs/RELEASING.md,
       "Public API baseline"). -->
</Project>
