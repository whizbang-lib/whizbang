{
  "title": "Whizbang Integrity",
  "uid": "whizbang-integrity",
  "description": "Stream integrity for a Whizbang service: service pairs and the pair guard, the deficit and its repair, seals and re-checks, and the cleanup sweeps. Reads the Whizbang.StreamIntegrity, Whizbang.Maintenance and Whizbang.Archive.AzureBlob meters through Prometheus. Traces of the same work are on the Whizbang.Integrity activity source.",
  "tags": [
    "whizbang",
    "integrity"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(whizbang_stream_integrity_unhealed_buckets, job)",
          "refId": "job"
        },
        "definition": "label_values(whizbang_stream_integrity_unhealed_buckets, job)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Service pairs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Halted pairs",
      "description": "Service pairs the pair guard holds halted because their eligibility rules differ (PairGuard). Integrity compares, repairs and redelivers nothing for a halted pair until both sides apply the same rules.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "count(max by (job, peer, side) (whizbang_stream_integrity_pair_state{job=~\"$job\",state=\"halted\"}))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "How long each pair has been halted",
      "description": "Seconds since each halted pair was first seen halted. The alert fires at PairGuard:HaltedAlertAfter (2 hours by default).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, peer, side) (whizbang_stream_integrity_pair_halted_seconds{job=~\"$job\"})",
          "legendFormat": "{{job}} / {{peer}} ({{side}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Rule versions in the fleet",
      "description": "Distinct rule fingerprints the selected services report; more than one means a rollout is in progress or a service runs other rules.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "count(count by (fingerprint) (whizbang_stream_integrity_rule_fingerprint_info{job=~\"$job\"}))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "id": 5,
      "title": "Deficit and repair",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Missing events left to heal",
      "description": "Events summed over the ledger buckets repair can still act on. A value that stays above zero is a sustained deficit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job) (whizbang_stream_integrity_unhealed_deficit_events{job=~\"$job\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Unhealed buckets by kind",
      "description": "Ledger buckets not yet healed: only a deficit is one repair heals.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, kind) (whizbang_stream_integrity_unhealed_buckets_by_kind{job=~\"$job\"})",
          "legendFormat": "{{job}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Oldest unhealed divergence",
      "description": "Age of the longest-standing unhealed divergence: a transient blip falls back, a stuck one keeps growing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job) (whizbang_stream_integrity_oldest_unhealed_age_seconds{job=~\"$job\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Repair requests sent",
      "description": "Redelivery requests per second, by what sent them (drain, audit, checkpoint, operator).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "sum by (job, source) (rate(whizbang_stream_integrity_repairs_requested_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Events repaired",
      "description": "Children of redelivery bundles applied, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "sum by (job) (rate(whizbang_stream_integrity_repaired_events_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Redelivery requests refused",
      "description": "Requests an origin declined, by reason: pair_halted (the pair guard), own_request (its own broadcast came back).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "sum by (job, reason) (increase(whizbang_stream_integrity_redelivery_requests_ignored_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "id": 12,
      "title": "Seals and re-checks",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Epoch frontier",
      "description": "Per lane, the sequence below which every digest epoch is sealed. The empty origin_service_id is the local lane.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, origin_service_id) (whizbang_stream_integrity_epoch_frontier{job=~\"$job\"})",
          "legendFormat": "{{job}} {{origin_service_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Seal age",
      "description": "Per lane, seconds since the epoch frontier last advanced. It grows between closures; one that keeps growing while events arrive means sealing has stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, origin_service_id) (whizbang_stream_integrity_seal_age_seconds{job=~\"$job\"})",
          "legendFormat": "{{job}} {{origin_service_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Verified share",
      "description": "Each origin's verified watermark as a share of the latest position its checkpoints announced.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, origin_service_id) (whizbang_stream_integrity_verified_percent{job=~\"$job\"})",
          "legendFormat": "{{job}} {{origin_service_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "id": 16,
      "title": "Re-checks",
      "description": "Whether each opt-in check is on, the share of the lookback the seal re-check covered within its interval, and seconds since each last ran in any instance.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, check) (whizbang_stream_integrity_recheck_enabled{job=~\"$job\"})",
          "legendFormat": "enabled"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, check) (whizbang_stream_integrity_recheck_coverage_ratio{job=~\"$job\"})",
          "legendFormat": "coverage"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "expr": "time() - max by (job, check) (whizbang_stream_integrity_recheck_last_run_timestamp_seconds{job=~\"$job\"})",
          "legendFormat": "since last run"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 17,
      "title": "Drift found by a check",
      "description": "Drift an opt-in check found: epochs for the seal re-check, buckets for the full-history compare. Anything above zero is an unaccounted write path.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "sum by (job, check) (increase(whizbang_stream_integrity_check_drift_found_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{check}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 18,
      "title": "Open window",
      "description": "Per lane, the events above the epoch frontier waiting to be sealed (capped=true: at least that many). A window that keeps growing means sealing is not keeping up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, origin_service_id) (whizbang_stream_integrity_open_window_events{job=~\"$job\"})",
          "legendFormat": "{{job}} {{origin_service_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "Seals lowered",
      "description": "Seals this service lowered for an origin, by reason: rewrite (the origin rewrote verified history) or rule_change. Each one re-verifies history from the lowered seal.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "sum by (job, reason) (increase(whizbang_stream_integrity_seal_lowered_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "id": 20,
      "title": "Origin generation",
      "description": "This service's origin generation: it moves when the service rewrites history its consumers verified.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 43
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job) (whizbang_stream_integrity_origin_generation{job=~\"$job\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Buckets carrying a cut",
      "description": "Stream digest buckets that still carry the per-stream detail of a cut (capped=true: at least that many); falls as the resting period rolls the detail off.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job) (whizbang_stream_integrity_carried_streams{job=~\"$job\"})",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Cuts that carried their digest",
      "description": "Prefix truncates and archives that removed events and carried their digest, by kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "sum by (job, kind) (increase(whizbang_stream_integrity_carried_compactions_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "id": 23,
      "title": "Sweeps",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 24,
      "title": "Oldest operational record",
      "description": "Age of the oldest operational record the retention sweep left, by category. Above twice the category's retention, the sweep is not keeping up.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 60
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, category) (whizbang_maintenance_operational_oldest_age_seconds{job=~\"$job\"})",
          "legendFormat": "{{job}} {{category}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "id": 25,
      "title": "Rows cleanup would remove now",
      "description": "Rows each maintenance task would remove now; capped=true means at least that many.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 60
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "expr": "max by (job, task) (whizbang_maintenance_pending_rows{job=~\"$job\"})",
          "legendFormat": "{{job}} {{task}}"
        }
      ],
