<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <WhizbangTestTags>Unit</WhizbangTestTags>
    <!-- Unit: fast tests, no external infrastructure. Until #1264 this project declared no type, so
         Run-Tests.ps1 never selected it and its tests ran in no CI suite. -->
    <WhizbangTestType>Unit</WhizbangTestType>
    <OutputType>Exe</OutputType>
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Whizbang.LanguageServer\Whizbang.LanguageServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

</Project>
