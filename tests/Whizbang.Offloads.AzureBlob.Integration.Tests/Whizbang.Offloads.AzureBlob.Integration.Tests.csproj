<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Integration: Requires Azurite via Testcontainers -->
    <WhizbangTestType>Integration</WhizbangTestType>
    <!-- Tags for filtering: AzureBlob, Docker, Offloads -->
    <WhizbangTestTags>AzureBlob;Docker;Offloads</WhizbangTestTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Whizbang.Core/Whizbang.Core.csproj" />
    <ProjectReference Include="../../src/Whizbang.Offloads.AzureBlob/Whizbang.Offloads.AzureBlob.csproj" />
  </ItemGroup>

</Project>
