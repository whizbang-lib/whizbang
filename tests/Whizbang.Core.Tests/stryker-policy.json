{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "project": "Whizbang.Core.csproj",
    "test-projects": [
      "./Whizbang.Core.Tests.csproj"
    ],
    "target-framework": "net10.0",
    "test-runner": "mtp",
    "reporters": [
      "cleartext",
      "json"
    ],
    "verbosity": "info",
    "concurrency": 4,
    "coverage-analysis": "perTest",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "**/Dispatch/Policy/*.cs",
      "!**/.whizbang/cache/**",
      "!**/*.g.cs",
      "!**/obj/**",
      "!**/bin/**",
      "!**/Generated/**",
      "!**/AssemblyInfo.cs"
    ],
    "ignore-mutations": [
      "string",
      "linq"
    ]
  }
}