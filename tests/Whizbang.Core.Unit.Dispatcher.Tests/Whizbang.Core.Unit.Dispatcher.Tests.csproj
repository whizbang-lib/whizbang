<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <WhizbangTestTags>Unit</WhizbangTestTags>
    <!-- Unit: Fast tests, no external infrastructure needed. Holds the Dispatcher, Security, Dispatch, SystemEvents
         and Audit unit tests of Whizbang.Core, split out of Whizbang.Core.Tests so that no one test compile
         dominates the build's memory (#2392). Namespaces stay Whizbang.Core.Tests.*; only the generated code moves
         to Whizbang.Core.Unit.Dispatcher.Tests.Generated, after this assembly's name. -->
    <WhizbangTestType>Unit</WhizbangTestType>
    <!-- Enable viewing generated files -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)/.whizbang/cache</CompilerGeneratedFilesOutputPath>
    <!-- Don't capture test output so Console.WriteLine appears in terminal -->
    <TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>
    <!-- Suppress CA1707: Test method names use underscores for readability (Given_When_Then pattern) -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <!-- Source generator output is automatically included in compilation -->
  <!-- EmitCompilerGeneratedFiles just writes them to disk for viewing -->
  <ItemGroup>
    <ProjectReference Include="../../src/Whizbang.Core/Whizbang.Core.csproj" />
    <ProjectReference Include="../../src/Whizbang.Data.Dapper.Postgres/Whizbang.Data.Dapper.Postgres.csproj" />
    <ProjectReference Include="../../src/Whizbang.Testing/Whizbang.Testing.csproj" />
    <!-- Source Generator reference -->
    <ProjectReference Include="../../src/Whizbang.Generators/Whizbang.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Rocks" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <!-- Test helpers shared between the Whizbang.Core unit test projects (#2392): each file has one home and is
       compiled into every test assembly that uses it, so the copies cannot drift. Only helper files are linked,
       never a file that holds tests, which would then run twice. -->
  <ItemGroup>
    <Compile Include="../Whizbang.Core.Tests/Helpers/*.cs" Link="Shared/Helpers/%(Filename)%(Extension)" />
    <Compile Include="../Whizbang.Core.Tests/Observability/MetricAssertionHelper.cs" Link="Shared/Observability/MetricAssertionHelper.cs" />
    <Compile Include="../Whizbang.Core.Unit.Workers.Tests/Workers/NoOpWorkCoordinator.cs" Link="Shared/Workers/NoOpWorkCoordinator.cs" />
  </ItemGroup>
</Project>