<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <WhizbangTestTags>Component</WhizbangTestTags>
    <!-- Component: saga watchdog delivery and routing through real hosted workers (StartAsync) in one process, no external infrastructure. The unit tests stay in Whizbang.Sagas.Tests (docs/TEST-PROJECTS.md). -->
    <WhizbangTestType>Component</WhizbangTestType>
    <TestingPlatformCaptureOutput>false</TestingPlatformCaptureOutput>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Whizbang.Core/Whizbang.Core.csproj" />
    <ProjectReference Include="../../src/Whizbang.Sagas.Contracts/Whizbang.Sagas.Contracts.csproj" />
    <ProjectReference Include="../../src/Whizbang.Sagas/Whizbang.Sagas.csproj" />
    <!-- The multi-service harness: a real transport consumer over an in-memory wire, so a watchdog
         tick's subscription and delivery are exercised as a transport carries them. -->
    <ProjectReference Include="../../src/Whizbang.Testing/Whizbang.Testing.csproj" />
    <ProjectReference Include="../../src/Whizbang.Sagas.Generators/Whizbang.Sagas.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The consumer-side JSON generator. A real saga consumer always has both analyzers loaded;
         running them together here is what proves a [Saga] declaration ends up with serializable
         events (Whizbang.Core's Analyzer ProjectReference does not flow transitively). -->
    <ProjectReference Include="../../src/Whizbang.Generators/Whizbang.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>


  <!-- The test sagas are shared with the unit project: one source, compiled into both test assemblies,
       so the saga generator emits them in each. -->
  <ItemGroup>
    <Compile Include="../Whizbang.Sagas.Tests/Generators/GeneratorTestSagas.cs" Link="Shared/GeneratorTestSagas.cs" />
  </ItemGroup>
</Project>
