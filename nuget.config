<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain hardening: every package restored under this repo must carry a valid
  signature chain. signatureValidationMode=require rejects unsigned packages at
  extraction time; the trustedSigners section pins WHO may sign them.

  nuget.org repository-countersigns every package it serves (author-unsigned ones
  included), so trusting the nuget.org repository certificate accepts the full
  dependency graph while still rejecting a package that did not come through
  nuget.org's signing pipeline (e.g. a poisoned cache entry or a spoofed feed).

  When nuget.org rotates its repository certificate, restore starts failing with
  NU3034; refresh the fingerprints with:
    dotnet nuget trust sync nuget.org [dash][dash]configfile nuget.config
  (replace [dash][dash] with two hyphens; XML comments cannot contain them.)

  Verification runs at package EXTRACTION, so an already-populated local cache
  (~/.nuget/packages) is not re-checked; CI cache misses and fresh clones are.

  Platform note: NuGet enforces this on Windows and Linux only — macOS restores
  skip signature verification entirely (verified empirically: corrupted
  fingerprints still restore on macOS but fail with NU3034 on Linux). The
  enforcement point is therefore CI's ubuntu runners, not local macOS dev.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
        <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
        <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
        <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      </repository>
  </trustedSigners>
</configuration>
