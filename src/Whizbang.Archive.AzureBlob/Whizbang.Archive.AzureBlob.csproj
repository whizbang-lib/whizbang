<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Replaced by Whizbang.Storage.AzureBlob, which this release depends on: the earlier registration calls compile and work, marked obsolete. Reference Whizbang.Storage.AzureBlob instead.</Description>
    <!-- The README package table groups by these (scripts/Update-ReadmeStats.ps1). -->
    <WhizbangPackageTier>Application</WhizbangPackageTier>
    <WhizbangPackageArea>Event archive</WhizbangPackageArea>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Whizbang.Core/Whizbang.Core.csproj" />
    <ProjectReference Include="../Whizbang.Storage.AzureBlob/Whizbang.Storage.AzureBlob.csproj" />
  </ItemGroup>

</Project>
