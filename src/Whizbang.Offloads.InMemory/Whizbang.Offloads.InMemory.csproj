<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>In-memory IMessageBodyStore provider for Whizbang offloads. Dev/test/fixture use only — bodies live in process memory and disappear at restart.</Description>
    <!-- The README package table groups by these (scripts/Update-ReadmeStats.ps1). -->
    <WhizbangPackageTier>Application</WhizbangPackageTier>
    <WhizbangPackageArea>Message offload</WhizbangPackageArea>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Whizbang.Offloads.InMemory.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Whizbang.Core/Whizbang.Core.csproj" />
  </ItemGroup>

</Project>
