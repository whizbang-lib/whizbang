<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Aspire hosting extensions for Whizbang RabbitMQ integration with automatic topology configuration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <!-- Security pin: MessagePack arrives transitively via Aspire.Hosting -> StreamJsonRpc.
         2.5.192 is vulnerable (GHSA-hv8m-jj95-wg3x); this direct reference lifts it to the
         patched 2.5.301. Remove once Aspire.Hosting/StreamJsonRpc flow a patched MessagePack. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Whizbang.Transports.RabbitMQ/Whizbang.Transports.RabbitMQ.csproj" />
  </ItemGroup>

</Project>
