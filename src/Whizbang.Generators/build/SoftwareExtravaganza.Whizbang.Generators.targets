<Project>
  <!-- Whizbang Message Registry: extract JSON from generated C# (cross-platform) -->
  <UsingTask TaskName="WhizbangExtractMessageRegistryJson" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var content = File.ReadAllText(SourceFile);
        var marker = "internal const string Json = @\"";
        var start = content.IndexOf(marker);
        if (start < 0) {
            Log.LogError("Could not find JSON marker in " + SourceFile);
            return false;
        }
        start += marker.Length;
        var end = content.IndexOf("\";", start);
        if (end < 0) {
            Log.LogError("Could not find end of JSON string in " + SourceFile);
            return false;
        }
        var json = content.Substring(start, end - start).Replace("\"\"", "\"");

        var outputDir = Path.GetDirectoryName(OutputFile);
        if (!Directory.Exists(outputDir)) {
            Directory.CreateDirectory(outputDir);
        }

        // Only write if content changed (avoids triggering file watchers unnecessarily)
        if (File.Exists(OutputFile)) {
            using var sha = System.Security.Cryptography.SHA256.Create();
            var existingHash = Convert.ToBase64String(sha.ComputeHash(File.ReadAllBytes(OutputFile)));
            var newHash = Convert.ToBase64String(sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(json)));
            if (existingHash == newHash) {
                Log.LogMessage(MessageImportance.Low, "Whizbang: Registry unchanged, skipping write");
                return true;
            }
        }

        File.WriteAllText(OutputFile, json);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Post-build task to extract message registry JSON from generated C# file.
       message-registry.json is a REGENERABLE artifact (rebuilt from source on every compile), so it
       lives in the git-ignored .whizbang-generated/ folder — NOT beside the committed ledger in
       .whizbang/. Convention: .whizbang-generated/ = ephemeral/ignored, .whizbang/ = committed. -->
  <Target Name="WhizbangExtractMessageRegistry" AfterTargets="Build" Condition="'$(WhizbangEmitMessageRegistry)' == 'true'">
    <PropertyGroup>
      <WhizbangGeneratedDir>$(MSBuildProjectDirectory)/.whizbang-generated</WhizbangGeneratedDir>
      <WhizbangGeneratedCSharpFile>$(CompilerGeneratedFilesOutputPath)/Whizbang.Generators/Whizbang.Generators.MessageRegistryGenerator/MessageRegistry.g.cs</WhizbangGeneratedCSharpFile>
      <WhizbangRegistryJsonFile>$(WhizbangGeneratedDir)/message-registry.json</WhizbangRegistryJsonFile>
    </PropertyGroup>

    <!-- Extract JSON from generated C# file (cross-platform) -->
    <WhizbangExtractMessageRegistryJson
      SourceFile="$(WhizbangGeneratedCSharpFile)"
      OutputFile="$(WhizbangRegistryJsonFile)"
      Condition="Exists('$(WhizbangGeneratedCSharpFile)')" />

    <Message
      Text="Whizbang: Message registry extracted to $(WhizbangRegistryJsonFile)"
      Importance="normal"
      Condition="Exists('$(WhizbangRegistryJsonFile)')" />
  </Target>

  <!-- Rename platform: extract the pinned-type ledger JSON from generated C# to the committed .whizbang/ lockfile.
       Reuses the generic extraction task above. The generator MERGES with the existing committed ledger, so this
       write is a monotonic lockfile update (adds new pinned types; never rewrites a recorded name/history). -->
  <Target Name="WhizbangExtractPinnedTypeLedger" AfterTargets="Build"
          Condition="'$(WhizbangEmitMessageRegistry)' == 'true' And '$(WhizbangIncludePinnedTypeLedger)' != 'false'">
    <PropertyGroup>
      <WhizbangLedgerGeneratedCSharpFile>$(CompilerGeneratedFilesOutputPath)/Whizbang.Generators/Whizbang.Generators.PinnedTypeLedgerGenerator/PinnedTypeLedger.g.cs</WhizbangLedgerGeneratedCSharpFile>
      <WhizbangPinnedTypeLedgerFile>$(MSBuildProjectDirectory)/.whizbang/pinned-type-ledger.json</WhizbangPinnedTypeLedgerFile>
    </PropertyGroup>

    <WhizbangExtractMessageRegistryJson
      SourceFile="$(WhizbangLedgerGeneratedCSharpFile)"
      OutputFile="$(WhizbangPinnedTypeLedgerFile)"
      Condition="Exists('$(WhizbangLedgerGeneratedCSharpFile)')" />

    <Message
      Text="Whizbang: Pinned-type ledger extracted to $(WhizbangPinnedTypeLedgerFile)"
      Importance="normal"
      Condition="Exists('$(WhizbangPinnedTypeLedgerFile)')" />
  </Target>
</Project>
