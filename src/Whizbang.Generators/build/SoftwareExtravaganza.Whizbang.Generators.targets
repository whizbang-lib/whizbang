<Project>
  <!-- Where the message registry finds the documentation checkout for its docs and tests maps (#1180). The generator
       reads only these build inputs, never the process environment, so its output is the same on every machine for
       the same inputs. WhizbangDocsPath defaults from the WHIZBANG_DOCS_PATH environment variable, which MSBuild
       captures as a build input; without it the generator looks for a whizbang-lib.github.io sibling of the git root
       above ProjectDir. -->
  <PropertyGroup>
    <WhizbangDocsPath Condition="'$(WhizbangDocsPath)' == ''">$(WHIZBANG_DOCS_PATH)</WhizbangDocsPath>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="WhizbangDocsPath" />
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

  <!-- Whizbang Message Registry: extract JSON from generated C# (cross-platform) -->
  <UsingTask TaskName="WhizbangExtractMessageRegistryJson" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var content = File.ReadAllText(SourceFile);
        var marker = "internal const string Json = @\"";
        var start = content.IndexOf(marker);
        if (start < 0) {
            Log.LogError("Could not find JSON marker in " + SourceFile);
            return false;
        }
        start += marker.Length;
        var end = content.IndexOf("\";", start);
        if (end < 0) {
            Log.LogError("Could not find end of JSON string in " + SourceFile);
            return false;
        }
        var json = content.Substring(start, end - start).Replace("\"\"", "\"");

        var outputDir = Path.GetDirectoryName(OutputFile);
        if (!Directory.Exists(outputDir)) {
            Directory.CreateDirectory(outputDir);
        }

        // Only write if content changed (avoids triggering file watchers unnecessarily)
        if (File.Exists(OutputFile)) {
            using var sha = System.Security.Cryptography.SHA256.Create();
            var existingHash = Convert.ToBase64String(sha.ComputeHash(File.ReadAllBytes(OutputFile)));
            var newHash = Convert.ToBase64String(sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(json)));
            if (existingHash == newHash) {
                Log.LogMessage(MessageImportance.Low, "Whizbang: Registry unchanged, skipping write");
                return true;
            }
        }

        File.WriteAllText(OutputFile, json);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Writes the single committed README.md at the root of the .whizbang/ folder, describing both
       the committed files there and the ignored cache/ subfolder. Idempotent: only writes when the
       content differs, to avoid file-watcher churn. -->
  <UsingTask TaskName="WhizbangWriteFolderReadme" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var content =
            "# .whizbang/\n" +
            "\n" +
            "Whizbang writes files here in two categories.\n" +
            "\n" +
            "## Committed — the files directly in this folder\n" +
            "\n" +
            "- `pinned-type-ledger.json` — the pinned-type rename lockfile. **Commit it.** It records\n" +
            "  rename history (former-name aliases) that cannot be regenerated from source, so old\n" +
            "  serialized events keep deserializing after a type is renamed.\n" +
            "\n" +
            "## Ignored — everything under `cache/`\n" +
            "\n" +
            "- generated `.cs` and `message-registry.json`, rebuilt from source on every build.\n" +
            "\n" +
            "Add `**/.whizbang/cache/` to your `.gitignore`. Commit everything else in `.whizbang/`\n" +
            "(including this README).\n" +
            "\n" +
            "_Generated by the Whizbang build. Set `WhizbangEmitFolderReadmes=false` to stop._\n";
        var dir = Path.GetDirectoryName(OutputFile);
        if (!Directory.Exists(dir)) {
            Directory.CreateDirectory(dir);
        }
        if (File.Exists(OutputFile) && File.ReadAllText(OutputFile) == content) {
            return true;
        }
        File.WriteAllText(OutputFile, content);
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Where the two extraction targets below read and write. Set in a target they depend on, not inside them,
       because a target's Inputs and Outputs are evaluated before its body runs (after its DependsOnTargets), and
       not at file level, where IntermediateOutputPath may not be set yet when this file is imported. -->
  <Target Name="WhizbangResolveExtractionPaths">
    <PropertyGroup>
      <WhizbangCacheDir>$(MSBuildProjectDirectory)/.whizbang/cache</WhizbangCacheDir>
      <WhizbangGeneratedCSharpFile>$(CompilerGeneratedFilesOutputPath)/Whizbang.Generators/Whizbang.Generators.MessageRegistryGenerator/MessageRegistry.g.cs</WhizbangGeneratedCSharpFile>
      <WhizbangRegistryJsonFile>$(WhizbangCacheDir)/message-registry.json</WhizbangRegistryJsonFile>
      <WhizbangRegistryStampFile>$(IntermediateOutputPath)whizbang-message-registry.stamp</WhizbangRegistryStampFile>
      <WhizbangLedgerGeneratedCSharpFile>$(CompilerGeneratedFilesOutputPath)/Whizbang.Generators/Whizbang.Generators.PinnedTypeLedgerGenerator/PinnedTypeLedger.g.cs</WhizbangLedgerGeneratedCSharpFile>
      <WhizbangPinnedTypeLedgerFile>$(MSBuildProjectDirectory)/.whizbang/pinned-type-ledger.json</WhizbangPinnedTypeLedgerFile>
      <WhizbangFolderReadmeFile>$(MSBuildProjectDirectory)/.whizbang/README.md</WhizbangFolderReadmeFile>
      <WhizbangLedgerStampFile>$(IntermediateOutputPath)whizbang-pinned-type-ledger.stamp</WhizbangLedgerStampFile>
    </PropertyGroup>
    <!-- A generated file that does not exist is left out of the Inputs: MSBuild treats a missing input as out of
         date, so a project the generator writes nothing for would run the target on every build. -->
    <ItemGroup>
      <WhizbangRegistryInput Include="$(MSBuildThisFileFullPath)" />
      <WhizbangRegistryInput Include="$(WhizbangGeneratedCSharpFile)" Condition="Exists('$(WhizbangGeneratedCSharpFile)')" />
      <WhizbangLedgerInput Include="$(MSBuildThisFileFullPath)" />
      <WhizbangLedgerInput Include="$(WhizbangLedgerGeneratedCSharpFile)" Condition="Exists('$(WhizbangLedgerGeneratedCSharpFile)')" />
    </ItemGroup>
  </Target>

  <!-- Both extraction targets run in every build of a consuming project, so each declares Inputs (the generated
       file it reads, and this file, whose extraction logic it runs) and Outputs (a stamp in obj/) and is skipped
       on a build where the generated file did not change (#1665). The JSON itself is not the output: the task
       writes it only when its content changes, so it can stay older than a regenerated .g.cs and would make the
       target run on every build. The stamp is touched every time the target runs, and a missing JSON file
       deletes the stamp first, so deleting the JSON brings it back on the next build. -->

  <!-- Post-build task to extract message registry JSON from generated C# file.
       message-registry.json is a REGENERABLE artifact (rebuilt from source on every compile), so it
       lives in the git-ignored .whizbang/cache/ subfolder — NOT beside the committed ledger at the
       .whizbang/ root. Convention: .whizbang/cache/ = ephemeral/ignored, .whizbang/ = committed. -->
  <Target Name="WhizbangPrepareMessageRegistry" DependsOnTargets="WhizbangResolveExtractionPaths"
          Condition="'$(WhizbangEmitMessageRegistry)' == 'true'">
    <Delete Files="$(WhizbangRegistryStampFile)"
            Condition="Exists('$(WhizbangGeneratedCSharpFile)') And !Exists('$(WhizbangRegistryJsonFile)')" />
  </Target>

  <Target Name="WhizbangExtractMessageRegistry" AfterTargets="Build" Condition="'$(WhizbangEmitMessageRegistry)' == 'true'"
          DependsOnTargets="WhizbangPrepareMessageRegistry"
          Inputs="@(WhizbangRegistryInput)"
          Outputs="$(WhizbangRegistryStampFile)">
    <!-- Extract JSON from generated C# file (cross-platform) -->
    <WhizbangExtractMessageRegistryJson
      SourceFile="$(WhizbangGeneratedCSharpFile)"
      OutputFile="$(WhizbangRegistryJsonFile)"
      Condition="Exists('$(WhizbangGeneratedCSharpFile)')" />

    <Message
      Text="Whizbang: Message registry extracted to $(WhizbangRegistryJsonFile)"
      Importance="normal"
      Condition="Exists('$(WhizbangRegistryJsonFile)')" />

    <Touch Files="$(WhizbangRegistryStampFile)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(WhizbangRegistryStampFile)" />
    </ItemGroup>
  </Target>

  <!-- Rename platform: extract the pinned-type ledger JSON from generated C# to the committed .whizbang/ lockfile.
       Reuses the generic extraction task above. The generator MERGES with the existing committed ledger, so this
       write is a monotonic lockfile update (adds new pinned types; never rewrites a recorded name/history). -->
  <Target Name="WhizbangPreparePinnedTypeLedger" DependsOnTargets="WhizbangResolveExtractionPaths"
          Condition="'$(WhizbangEmitMessageRegistry)' == 'true' And '$(WhizbangIncludePinnedTypeLedger)' != 'false'">
    <Delete Files="$(WhizbangLedgerStampFile)"
            Condition="Exists('$(WhizbangLedgerGeneratedCSharpFile)') And !Exists('$(WhizbangPinnedTypeLedgerFile)')" />
    <Delete Files="$(WhizbangLedgerStampFile)"
            Condition="'$(WhizbangEmitFolderReadmes)' != 'false' And Exists('$(WhizbangPinnedTypeLedgerFile)') And !Exists('$(WhizbangFolderReadmeFile)')" />
  </Target>

  <Target Name="WhizbangExtractPinnedTypeLedger" AfterTargets="Build"
          Condition="'$(WhizbangEmitMessageRegistry)' == 'true' And '$(WhizbangIncludePinnedTypeLedger)' != 'false'"
          DependsOnTargets="WhizbangPreparePinnedTypeLedger"
          Inputs="@(WhizbangLedgerInput)"
          Outputs="$(WhizbangLedgerStampFile)">
    <WhizbangExtractMessageRegistryJson
      SourceFile="$(WhizbangLedgerGeneratedCSharpFile)"
      OutputFile="$(WhizbangPinnedTypeLedgerFile)"
      Condition="Exists('$(WhizbangLedgerGeneratedCSharpFile)')" />

    <Message
      Text="Whizbang: Pinned-type ledger extracted to $(WhizbangPinnedTypeLedgerFile)"
      Importance="normal"
      Condition="Exists('$(WhizbangPinnedTypeLedgerFile)')" />

    <!-- Self-documenting: single committed README at the .whizbang/ root. Only written when a ledger
         exists — i.e. when .whizbang/ actually has committed content to explain. Projects with only
         the ignored cache/ subfolder stay fully ignored and invisible to git. -->
    <WhizbangWriteFolderReadme
      OutputFile="$(WhizbangFolderReadmeFile)"
      Condition="'$(WhizbangEmitFolderReadmes)' != 'false' And Exists('$(WhizbangPinnedTypeLedgerFile)')" />

    <Touch Files="$(WhizbangLedgerStampFile)" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(WhizbangLedgerStampFile)" />
    </ItemGroup>
  </Target>
</Project>
