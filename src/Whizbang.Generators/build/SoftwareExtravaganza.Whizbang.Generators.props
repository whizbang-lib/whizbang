<Project>
  <!-- Whizbang Message Registry: compiler settings for NuGet consumers -->
  <PropertyGroup>
    <!-- Consumers can set WhizbangEmitMessageRegistry=false to opt out -->
    <WhizbangEmitMessageRegistry Condition="'$(WhizbangEmitMessageRegistry)' == ''">true</WhizbangEmitMessageRegistry>
    <!-- Rename platform: consumers can set WhizbangIncludePinnedTypeLedger=false to opt out -->
    <WhizbangIncludePinnedTypeLedger Condition="'$(WhizbangIncludePinnedTypeLedger)' == ''">true</WhizbangIncludePinnedTypeLedger>
    <!-- Drop a single README.md at the root of the .whizbang/ folder explaining what it holds and
         whether to commit or ignore each part. Consumers can set WhizbangEmitFolderReadmes=false to
         opt out (e.g. if they document the convention themselves). -->
    <WhizbangEmitFolderReadmes Condition="'$(WhizbangEmitFolderReadmes)' == ''">true</WhizbangEmitFolderReadmes>
  </PropertyGroup>

  <!-- Rename platform (P0/P1): surface the committed pinned-type ledger to the analyzer + generators as an
       AdditionalFile so former-name aliases resolve and un-acknowledged renames are gated (WHIZ120/WHIZ121).
       The ledger is the COMMITTED source-of-truth lockfile and lives in .whizbang/ (tracked in git). The
       regenerable message-registry.json lives separately in the ignored .whizbang/cache/ folder. -->
  <ItemGroup Condition="'$(WhizbangIncludePinnedTypeLedger)' == 'true' And Exists('$(MSBuildProjectDirectory)/.whizbang/pinned-type-ledger.json')">
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/.whizbang/pinned-type-ledger.json" />
  </ItemGroup>

  <PropertyGroup Condition="'$(WhizbangEmitMessageRegistry)' == 'true'">
    <!-- Enable emitting compiler-generated files (only if consumer hasn't already set it) -->
    <EmitCompilerGeneratedFiles Condition="'$(EmitCompilerGeneratedFiles)' == ''">true</EmitCompilerGeneratedFiles>
    <!-- Default output path for generated files (only if consumer hasn't already set it): the
         ignored .whizbang/cache/ subfolder, so all regenerable Whizbang output lives in one place. -->
    <CompilerGeneratedFilesOutputPath Condition="'$(CompilerGeneratedFilesOutputPath)' == ''">$(MSBuildProjectDirectory)/.whizbang/cache</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
</Project>
