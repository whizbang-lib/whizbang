<Project>
  <!-- Whizbang Message Registry: compiler settings for NuGet consumers -->
  <PropertyGroup>
    <!-- The message registry (.whizbang/cache/message-registry.json) is IDE tooling for the VS Code extension, so it
         is off by default: set WhizbangEmitMessageRegistry=true to have the generator embed it and the build write
         it. Off, the generator embeds nothing and the extraction target is skipped (#1609). -->
    <WhizbangEmitMessageRegistry Condition="'$(WhizbangEmitMessageRegistry)' == ''">false</WhizbangEmitMessageRegistry>
    <!-- Rename platform: the pinned-type ledger is the committed rename lockfile, on by default and independent of
         the registry; consumers can set WhizbangIncludePinnedTypeLedger=false to opt out -->
    <WhizbangIncludePinnedTypeLedger Condition="'$(WhizbangIncludePinnedTypeLedger)' == ''">true</WhizbangIncludePinnedTypeLedger>
    <!-- Drop a single README.md at the root of the .whizbang/ folder explaining what it holds and
         whether to commit or ignore each part. Consumers can set WhizbangEmitFolderReadmes=false to
         opt out (e.g. if they document the convention themselves). -->
    <WhizbangEmitFolderReadmes Condition="'$(WhizbangEmitFolderReadmes)' == ''">true</WhizbangEmitFolderReadmes>
  </PropertyGroup>

  <!-- WHIZ309 (a collective predicate on an unindexed field) is on by default. Consumers can set
       WhizbangCollectiveIndexWarning=false to turn it off for a project; a reasoned
       [SuppressIndexAdvisory] turns it off for one perspective, model or field instead. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="WhizbangCollectiveIndexWarning" />
  </ItemGroup>

  <!-- Every other property a generator reads must be declared here too, or a project's setting never reaches it
       and the default always applies (#1426; BuildPropertyVisibilityTests finds each read in the source).
       Table naming: WhizbangMaxIdentifierLength, WhizbangStripTableNameSuffixes, WhizbangTableNameSuffixesToStrip.
       WhizbangGuidInterceptionEnabled turns on Guid creation interception; WhizbangQueryComposingAttributes names
       a third party's query-composing attributes, comma separated. The Exclude keeps one item per name when the
       EF Core generators package declares the table-naming properties as well. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="WhizbangMaxIdentifierLength" Exclude="@(CompilerVisibleProperty)" />
    <CompilerVisibleProperty Include="WhizbangStripTableNameSuffixes" Exclude="@(CompilerVisibleProperty)" />
    <CompilerVisibleProperty Include="WhizbangTableNameSuffixesToStrip" Exclude="@(CompilerVisibleProperty)" />
    <CompilerVisibleProperty Include="WhizbangGuidInterceptionEnabled" Exclude="@(CompilerVisibleProperty)" />
    <CompilerVisibleProperty Include="WhizbangQueryComposingAttributes" Exclude="@(CompilerVisibleProperty)" />
  </ItemGroup>

  <!-- Rename platform (P0/P1): surface the committed pinned-type ledger to the analyzer + generators as an
       AdditionalFile so former-name aliases resolve and un-acknowledged renames are gated (WHIZ120/WHIZ121).
       The ledger is the COMMITTED source-of-truth lockfile and lives in .whizbang/ (tracked in git). The
       regenerable message-registry.json lives separately in the ignored .whizbang/cache/ folder. -->
  <ItemGroup Condition="'$(WhizbangIncludePinnedTypeLedger)' == 'true' And Exists('$(MSBuildProjectDirectory)/.whizbang/pinned-type-ledger.json')">
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/.whizbang/pinned-type-ledger.json" />
  </ItemGroup>

  <!-- The package no longer turns EmitCompilerGeneratedFiles on: writing every generated file to disk on every build
       cost each consumer build, and the registry and ledger are now read from the built assembly (#1609). A project
       that sets EmitCompilerGeneratedFiles=true itself still gets the files, by default in the ignored
       .whizbang/cache/ subfolder, so all regenerable Whizbang output lives in one place. -->
  <PropertyGroup>
    <CompilerGeneratedFilesOutputPath Condition="'$(CompilerGeneratedFilesOutputPath)' == ''">$(MSBuildProjectDirectory)/.whizbang/cache</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
</Project>
