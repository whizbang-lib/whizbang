<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Roslyn source generators for zero-reflection, AOT-compatible code generation including dispatcher routing, message registry, and diagnostics infrastructure.</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Whizbang.Generators</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <!-- Enable viewing generated files -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)/.whizbang/cache</CompilerGeneratedFilesOutputPath>
    <!-- Enable performance reporting -->
    <ReportAnalyzer>true</ReportAnalyzer>
    <!-- Suppress release tracking warnings for early development -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- NuGet packaging: Place in analyzers folder, not lib -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Use target to add analyzer DLL to correct path -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerDll</TargetsForTfmSpecificContentInPackage>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Enable ILRepack to merge Shared DLL into generator DLL -->
    <ILRepackEnabled>true</ILRepackEnabled>
    <!-- Exclude System.Index and System.Range from ILRepack merge -->
    <!-- These types are part of .NET runtime and should not be merged -->
    <ILRepackExcludeFilters>System.Index;System.Range</ILRepackExcludeFilters>
    <!-- Disable TypeForwardedTo generation for polyfills to avoid conflicts with .NET 10 test project -->
    <!-- See: https://github.com/Sergio0694/PolySharp/issues/103 -->
    <PolySharpExcludeTypeForwardedToDeclarations>true</PolySharpExcludeTypeForwardedToDeclarations>
  </PropertyGroup>
  <!-- Target to add the merged analyzer DLL + the sibling CodeFixes analyzer DLL to the -->
  <!-- package. Consumers referencing Whizbang.Generators load both as analyzers in one step. -->
  <!-- CodeFixes DLL is picked up from its sibling bin/ output if already built (see note below). -->
  <Target Name="PackAnalyzerDll">
    <PropertyGroup>
      <_CodeFixesDll>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Whizbang.Generators.CodeFixes\bin\$(Configuration)\netstandard2.0\Whizbang.Generators.CodeFixes.dll'))</_CodeFixesDll>
    </PropertyGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs/" />
      <TfmSpecificPackageFile Include="$(_CodeFixesDll)" PackagePath="analyzers/dotnet/cs/" Condition="Exists('$(_CodeFixesDll)')" />
    </ItemGroup>
    <Warning Text="Whizbang.Generators.CodeFixes.dll not found at $(_CodeFixesDll); the PinnedIdCodeFixProvider will not be packaged. Build Whizbang.Generators.CodeFixes before packing Whizbang.Generators." Condition="!Exists('$(_CodeFixesDll)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
    <!-- ILRepack to merge Shared DLL into generator DLL -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference the shared library and ensure it's packaged with the generator -->
    <ProjectReference Include="../Whizbang.Generators.Shared/Whizbang.Generators.Shared.csproj">
      <PrivateAssets>all</PrivateAssets>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <!-- Don't use OutputItemType=Analyzer for Shared - it needs to be copied as a regular dependency -->
    </ProjectReference>
  </ItemGroup>
  <!--
    NOTE: Whizbang.Generators.CodeFixes is intentionally NOT referenced as a ProjectReference.
    RS1038 forbids it (analyzer assemblies must not reference Workspaces), and Pack-LocalPackages.ps1
    uses 'dotnet pack' with NoBuild which conflicts with ProjectReference-triggered rebuilds. The
    PackAnalyzerDll target below bundles the CodeFixes DLL from its bin output if present —
    callers must build CodeFixes before packing Generators (the repo's build order does this).
  -->
  <ItemGroup>
    <!-- Template files - these are real C# code that gets full analyzer support -->
    <!-- BUT they must be excluded from compilation since they reference types not in this project -->
    <Compile Remove="Templates\**\*.cs" />
    <!-- Include as content so IDE can analyze them -->
    <None Include="Templates\**\*.cs" />
    <!-- Embed as resources so generator can read them at runtime -->
    <EmbeddedResource Include="Templates\**\*.cs" />

    <!-- SQL template files - embedded as resources for generator access -->
    <None Include="Templates\**\*.sql" />
    <EmbeddedResource Include="Templates\**\*.sql" />
  </ItemGroup>

  <!-- Pack MSBuild props/targets for NuGet consumers (build/ for direct, buildTransitive/ for transitive) -->
  <ItemGroup>
    <None Include="build\SoftwareExtravaganza.Whizbang.Generators.props" Pack="true" PackagePath="build\SoftwareExtravaganza.Whizbang.Generators.props" />
    <None Include="build\SoftwareExtravaganza.Whizbang.Generators.targets" Pack="true" PackagePath="build\SoftwareExtravaganza.Whizbang.Generators.targets" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\SoftwareExtravaganza.Whizbang.Generators.props" Pack="true" PackagePath="buildTransitive\SoftwareExtravaganza.Whizbang.Generators.props" CopyToOutputDirectory="Never" />
    <None Include="build\SoftwareExtravaganza.Whizbang.Generators.targets" Pack="true" PackagePath="buildTransitive\SoftwareExtravaganza.Whizbang.Generators.targets" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>