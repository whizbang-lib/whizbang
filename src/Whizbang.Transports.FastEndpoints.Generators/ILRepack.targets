<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Custom ILRepack configuration for Whizbang.Transports.FastEndpoints.Generators
    Merges Whizbang.Generators.Shared.dll into Whizbang.Transports.FastEndpoints.Generators.dll
    Runs in ALL configurations (Debug and Release) since generators need this during development
  -->
  <!-- Merges into the intermediate assembly, after compile and before the copy to the output folder, and only
       when the compiled assembly or the shared one changed. Merging in place in the output folder on every
       build rewrote the generator DLL each time, so every project that loads the generator recompiled on a
       build with nothing changed (#1609); and the copy from obj/ put the unmerged DLL back every time. -->
  <Target Name="MergeSharedAssembly" AfterTargets="CoreCompile" BeforeTargets="CopyFilesToOutputDirectory"
          Inputs="@(IntermediateAssembly);@(ReferencePath->WithMetadataValue('Filename','Whizbang.Generators.Shared'))"
          Outputs="$(IntermediateOutputPath)$(TargetName).merged.stamp">
    <ItemGroup>
      <!-- Main assembly (must be first) -->
      <InputAssemblies Include="@(IntermediateAssembly->'%(FullPath)')" />
      <!-- Shared libraries to merge -->
      <InputAssemblies Include="@(ReferencePath->WithMetadataValue('Filename','Whizbang.Generators.Shared'))" />

      <!-- Build list of search directories from reference paths -->
      <_ILRepackSearchDir Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
    </ItemGroup>

    <PropertyGroup>
      <_ILRepackSearchDirs>@(_ILRepackSearchDir->Distinct(), ';')</_ILRepackSearchDirs>
    </PropertyGroup>

    <Message Text="ILRepack: Merging Whizbang.Generators.Shared.dll into $(TargetName)$(TargetExt)" Importance="High" />
    <Message Text="ILRepack: Search directories = $(_ILRepackSearchDirs)" Importance="High" />

    <!-- The package's copy, merged without symbols from the same inputs before the in-place merge replaces them: ILRepack
         writes the symbol file's path, under a per-run temp folder, into the assembly, so only this merge is identical
         in two builds of one commit (#2484). The package ships it (WhizbangPackagedAnalyzer, Directory.Build.targets). -->
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(WhizbangPackagedAnalyzer)'))" />
    <ILRepack
      Parallel="true"
      DebugInfo="false"
      Internalize="true"
      InputAssemblies="@(InputAssemblies)"
      TargetKind="SameAsPrimaryAssembly"
      OutputFile="$(WhizbangPackagedAnalyzer)"
      KeyFile="$(AssemblyOriginatorKeyFile)"
      LibraryPath="$(OutputPath);$(_ILRepackSearchDirs)"
    />
    <!-- The tests' copy, with symbols: coverage of the Whizbang.Generators.Shared code merged into it needs them. -->
    <ILRepack
      Parallel="true"
      DebugInfo="true"
      Internalize="true"
      InputAssemblies="@(InputAssemblies)"
      TargetKind="SameAsPrimaryAssembly"
      OutputFile="@(IntermediateAssembly->'%(FullPath)')"
      KeyFile="$(AssemblyOriginatorKeyFile)"
      LibraryPath="$(OutputPath);$(_ILRepackSearchDirs)"
    />
    <Touch Files="$(IntermediateOutputPath)$(TargetName).merged.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)$(TargetName).merged.stamp" />
      <FileWrites Include="$(WhizbangPackagedAnalyzer)" />
    </ItemGroup>
  </Target>

  <!-- Note: Cleanup disabled to prevent race conditions during parallel builds.
       The merged Shared DLL remains in output but doesn't affect functionality. -->
</Project>
