<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Enable packaging for library projects in src/ -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Library projects always build every framework W! ships for (#2135), not only in a release build: develop's
       alphas are packed from develop's build, and a consumer still on .NET 10 takes them. Tests, samples and tools
       keep the development framework day to day. Generators and analyzers override this with netstandard2.0. -->
  <PropertyGroup>
    <TargetFrameworks>$(WhizbangReleaseTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <!-- #2126: library code never stops the host or sets the exit code itself; every exit goes through the one exit path
       (WhizbangInstanceExit). Library projects only: the tools and samples are applications that own their exit. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../BannedSymbols.Exit.txt" />
  </ItemGroup>
</Project>
