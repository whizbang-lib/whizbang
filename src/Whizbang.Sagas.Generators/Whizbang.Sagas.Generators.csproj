<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Source generator for Whizbang.Sagas. Emits the nine nested saga event classes + typed Service + DI extension method from the [Saga&lt;TBase&gt;("Name")] attribute, removing boilerplate from every consumer that authors a saga.</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Whizbang.Sagas.Generators</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Merge the shared naming helper into the generator DLL, as the other generator packages do (issue #698) -->
    <ILRepackEnabled>true</ILRepackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one place type names are rendered on the generator side (TypeNameUtilities); ILRepacked into this DLL -->
    <ProjectReference Include="../Whizbang.Generators.Shared/Whizbang.Generators.Shared.csproj">
      <PrivateAssets>all</PrivateAssets>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
