<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Source generator for Whizbang.Sagas. Emits the nine nested saga event classes + typed Service + DI extension method from the [Saga&lt;TBase&gt;("Name")] attribute, removing boilerplate from every consumer that authors a saga.</Description>
    <!-- The README package table groups by these (scripts/Update-ReadmeStats.ps1). -->
    <WhizbangPackageTier>Patterns</WhizbangPackageTier>
    <WhizbangPackageArea>Sagas</WhizbangPackageArea>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Clears the net10.0/net11.0 list Directory.Build.props sets (#2135): Roslyn loads netstandard2.0 only. -->
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>Whizbang.Sagas.Generators</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Merge the shared naming helper into the generator DLL, as the other generator packages do (issue #698) -->
    <ILRepackEnabled>true</ILRepackEnabled>
    <!-- Symbols embedded, so the one merge in ILRepack.targets serves the tests, coverage and the package, and two
         builds of one commit write the same assembly (#2484, Directory.Build.targets, WhizbangRequireEmbeddedSymbols). -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one place type names are rendered on the generator side (TypeNameUtilities); ILRepacked into this DLL -->
    <ProjectReference Include="../Whizbang.Generators.Shared/Whizbang.Generators.Shared.csproj">
      <PrivateAssets>all</PrivateAssets>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
