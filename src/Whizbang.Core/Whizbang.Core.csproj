<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Core types, interfaces, and messaging infrastructure for building event-driven, CQRS, and event-sourced applications with zero reflection and AOT compatibility.</Description>
    <RootNamespace>Whizbang.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Configuration binding uses the interceptor-based source generator, so the
         BindConfiguration/Bind calls below compile to typed property assignments — the
         zero-reflection rule holds without hand-written per-key binders. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Emit source-generated files to disk for debugging -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)/.whizbang/cache</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <!-- Generate compile-time version constant from MSBuild $(Version) — no reflection needed -->
  <Target Name="GenerateVersionInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VersionInfoFile>$(IntermediateOutputPath)WhizbangVersionInfo.Generated.cs</_VersionInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_VersionInfoFile)" Overwrite="true" Lines="// &lt;auto-generated/&gt;
namespace Whizbang.Core.Diagnostics%3B

/// &lt;summary&gt;Compile-time version info stamped by MSBuild from $(Version).&lt;/summary&gt;
internal static class WhizbangVersionInfo
{
    internal const string Version = &quot;$(Version)&quot;%3B
}" />
    <ItemGroup>
      <Compile Include="$(_VersionInfoFile)" />
    </ItemGroup>
  </Target>
  <!-- Regenerate banner data if the generated file is missing (requires Python 3 + Pillow) -->
  <Target Name="GenerateBannerData" BeforeTargets="CoreCompile"
          Condition="!Exists('$(MSBuildProjectDirectory)/Diagnostics/WhizbangBanner.Generated.cs')">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/Build-Logo.ps1&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)/../.."
          IgnoreExitCode="true"
          StandardOutputImportance="Low" />
  </Target>
  <!-- Include message registry in NuGet package - added dynamically after build generates it -->
  <Target Name="IncludeMessageRegistryInPack" BeforeTargets="GenerateNuspec" DependsOnTargets="WhizbangExtractMessageRegistry">
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/.whizbang/message-registry.json')">
      <None Include="$(MSBuildProjectDirectory)/.whizbang/message-registry.json" Pack="true" PackagePath="contentFiles/any/any/.whizbang/">
        <PackageCopyToOutput>true</PackageCopyToOutput>
      </None>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Medo.Uuid7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reference source generators for build-time code generation -->
    <ProjectReference Include="../Whizbang.Generators/Whizbang.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pinned-type ledger as an AdditionalFile (mirrors what the NuGet .props does for consumers):
         activates WHIZ120/WHIZ121 rename governance for Whizbang.Core's own pinned types, lets the
         ledger generator MERGE with the committed history instead of regenerating from scratch, and
         feeds formerNames into the JSON-context alias registrations + catalog entries so rows
         persisted under a pre-rename CLR name keep resolving. -->
    <AdditionalFiles Include=".whizbang/pinned-type-ledger.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Testing support: test assemblies that access internal members. The strong-name
         public key is attached by the ItemDefinitionGroup in Directory.Build.props. -->
    <InternalsVisibleTo Include="Whizbang.Core.Tests" />
    <InternalsVisibleTo Include="Whizbang.Testing" />
    <InternalsVisibleTo Include="Whizbang.Observability.Tests" />
    <InternalsVisibleTo Include="Whizbang.Transports.Tests" />
    <InternalsVisibleTo Include="Whizbang.Policies.Tests" />
    <InternalsVisibleTo Include="Whizbang.Execution.Tests" />
    <InternalsVisibleTo Include="Whizbang.Documentation.Tests" />
    <InternalsVisibleTo Include="Whizbang.Data.Postgres.Tests" />
    <InternalsVisibleTo Include="Whizbang.Benchmarks" />
    <!-- Allow generated code to access internals -->
    <InternalsVisibleTo Include="Whizbang.Core.Generated" />
    <!-- Mocking framework support (Rocks uses source generation, but just in case).
         Castle's runtime proxy assembly signs with Castle's well-known key, not ours. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
  </ItemGroup>
</Project>
