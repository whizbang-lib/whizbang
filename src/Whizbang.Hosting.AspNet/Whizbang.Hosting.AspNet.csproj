<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- The hosting options bind from configuration. With the generator on, the ConfigurationBinder.Bind
         calls in ServiceCollectionExtensions compile to typed property assignments, so the
         zero-reflection rule holds and the calls stay AOT-clean (without it they raise IL3050). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <Description>ASP.NET Core hosting extensions for Whizbang — flush middleware for request-scoped work coordination.</Description>
    <!-- The README package table groups by these (scripts/Update-ReadmeStats.ps1). -->
    <WhizbangPackageTier>Application</WhizbangPackageTier>
    <WhizbangPackageArea>Hosting</WhizbangPackageArea>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Whizbang.Hosting.AspNet.Tests" />
    <InternalsVisibleTo Include="Whizbang.Hosting.AspNet.Component.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whizbang.Core\Whizbang.Core.csproj" />
  </ItemGroup>
</Project>
