<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Saga event interfaces, item-state enums, and SagaContext. Consumed by Whizbang.Sagas runtime + Whizbang.Sagas.Generators source generator; carries no behavior so it can ship to AOT clients without dragging the runtime.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whizbang.Core\Whizbang.Core.csproj" />
  </ItemGroup>

</Project>
