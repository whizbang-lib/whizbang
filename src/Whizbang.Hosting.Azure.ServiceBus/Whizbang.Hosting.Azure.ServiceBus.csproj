<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Description>Aspire hosting extensions for Whizbang Azure Service Bus integration</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Security pin: MessagePack arrives transitively via Aspire.Hosting -> StreamJsonRpc.
         The transitive 2.5.192 has a known high-severity vulnerability (CVE-2026-48109,
         GHSA-hv8m-jj95-wg3x). Referenced directly so Central Package Management forces the
         patched 2.5.301. Remove once Aspire.Hosting/StreamJsonRpc flow a patched MessagePack. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whizbang.Core\Whizbang.Core.csproj" />
    <ProjectReference Include="..\Whizbang.Transports.AzureServiceBus\Whizbang.Transports.AzureServiceBus.csproj" />
  </ItemGroup>
</Project>
