<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Multi-stream saga coordination on Whizbang.Core: BaseSagaModel, SagaItemModel, per-item stream routing, completion reconciliation, and SagaCompletionGuard backed by IDispatcher.PublishOnceAsync. Pair with Whizbang.Sagas.Generators for the [Saga&lt;TBase&gt;("Name")] attribute and zero-boilerplate event generation.</Description>
    <!-- The README package table groups by these (scripts/Update-ReadmeStats.ps1). -->
    <WhizbangPackageTier>Patterns</WhizbangPackageTier>
    <WhizbangPackageArea>Sagas</WhizbangPackageArea>
    <TargetFramework>net10.0</TargetFramework>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- SagaOptions binds from Whizbang:Sagas. With the generator on, that ConfigurationBinder.Bind call
         compiles to typed property assignments, so it stays reflection-free and AOT-clean. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whizbang.Core\Whizbang.Core.csproj" />
    <ProjectReference Include="..\Whizbang.Sagas.Contracts\Whizbang.Sagas.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Whizbang.Sagas.Tests" />
    <InternalsVisibleTo Include="Whizbang.Sagas.Component.Tests" />
  </ItemGroup>

</Project>
