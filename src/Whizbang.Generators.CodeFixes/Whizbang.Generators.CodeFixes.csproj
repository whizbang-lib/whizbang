<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Not packable as a standalone NuGet: Whizbang.Generators bundles this DLL into its -->
    <!-- analyzers/dotnet/cs/ output so consumers get analyzer + code fixes in one package. -->
    <IsPackable>false</IsPackable>
    <Description>Roslyn code fix providers for Whizbang analyzers — e.g., inserts [PinnedId("&lt;new-guid&gt;")] on WHIZ110/WHIZ111.</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Whizbang.Generators.CodeFixes</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <!-- Suppress release tracking warnings for early development -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- NuGet packaging: Place in analyzers folder, not lib -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalyzerDll</TargetsForTfmSpecificContentInPackage>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Disable TypeForwardedTo generation to avoid conflicts with .NET 10 test project -->
    <PolySharpExcludeTypeForwardedToDeclarations>true</PolySharpExcludeTypeForwardedToDeclarations>
  </PropertyGroup>

  <Target Name="PackAnalyzerDll">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack MSBuild props/targets so consumers get both analyzer and code-fix DLLs together -->
  <ItemGroup>
    <None Include="build\SoftwareExtravaganza.Whizbang.Generators.CodeFixes.props"
          Pack="true"
          PackagePath="build\SoftwareExtravaganza.Whizbang.Generators.CodeFixes.props"
          Condition="Exists('build\SoftwareExtravaganza.Whizbang.Generators.CodeFixes.props')" />
  </ItemGroup>
</Project>
