<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Repository-internal: loaded as an analyzer by this repository's test projects (tests/Directory.Build.props
         and samples/Directory.Build.props), never shipped. It lives under src/ so the new-code coverage gate, which reads src/, holds it to the same
         standard as the library. Its diagnostic IDs are in diagnostic-ids.txt with every other ID in the repository. -->
    <IsPackable>false</IsPackable>
    <Description>Repository-internal Roslyn analyzers for this repository's test code: assertions that cannot fail, and test classes a sharded CI run would skip.</Description>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Clears the net10.0/net11.0 list Directory.Build.props sets (#2135): Roslyn loads netstandard2.0 only. -->
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>Whizbang.TestAnalyzers</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <!-- Release tracking files are for shipped analyzer packages; this one never ships. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- The root props turn the AOT analyzers on for every project whose name does not mark it as Roslyn
         tooling; an analyzer runs inside the compiler, on netstandard2.0, where they do not apply (NETSDK1210). -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <PolySharpExcludeTypeForwardedToDeclarations>true</PolySharpExcludeTypeForwardedToDeclarations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
