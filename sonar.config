# Shared Sonar configuration — single source of truth for CI and local
# Used by: CI (reusable-quality.yml), local (Run-LocalSonarAnalysis.ps1, Run-PR.ps1)
# Format: one property per line, key=value (lines starting with # are ignored)

# Code analysis exclusions (not analyzed at all)
# node_modules/.next/.angular/dist: JS/Angular build artefacts. Must stay listed even though
# `**/samples/**` already covers them — the scanner walks these paths before applying exclusions,
# so explicit entries provide a second line of defence against stalls (pnpm symlink farms etc.).
# Scripts/PR-Readiness-Common.psm1 additionally strips these dirs from the local scan folder.
sonar.exclusions=**/samples/**,**/benchmarks/**,**/tools/**,**/node_modules/**,**/.next/**,**/.angular/**,**/dist/**,**/*Generated.cs,**/.whizbang-generated/**,**/scripts/**

# Copy-paste detection exclusions
# SlidingWindow{Inbox,Apply,Outbox}BatchStrategy are intentional near-identical variants of the same
# sliding-window batching shape (differ only in message type + the flush target); their structural
# similarity is by design, like EFCorePostgresLensQuery below.
sonar.cpd.exclusions=**/tests/**,**/tools/**,**/samples/**,**/benchmarks/**,src/Whizbang.Generators/**,src/Whizbang.Generators.Shared/**,src/Whizbang.Data.EFCore.Postgres.Generators/**,src/Whizbang.Transports.HotChocolate.Generators/**,src/Whizbang.Transports.FastEndpoints.Generators/**,src/Whizbang.Sagas.Generators/**,**/EFCorePostgresLensQuery.cs,**/SlidingWindow*BatchStrategy.cs,**/*.sql

# Issue ignore: RCS1118 (mark as const) conflicts with TUnit's TUnitAssertions0005
# (Assert.That must not be used with constant value). Cannot satisfy both in test code.
sonar.issue.ignore.multicriteria=t1,t2,t3,t4,t5,t6,t7,t8,s1,s2,s3,s4,s5,s6
sonar.issue.ignore.multicriteria.t1.ruleKey=external_roslyn:RCS1118
sonar.issue.ignore.multicriteria.t1.resourceKey=**/tests/**
# RCS1163 in tests: unused params are common in test fakes/mocks matching interface signatures
sonar.issue.ignore.multicriteria.t2.ruleKey=external_roslyn:RCS1163
sonar.issue.ignore.multicriteria.t2.resourceKey=**/tests/**
# RCS1021 in tests: lambda→method group conversion conflicts with Assert.That(() => ...) patterns
sonar.issue.ignore.multicriteria.t3.ruleKey=external_roslyn:RCS1021
sonar.issue.ignore.multicriteria.t3.resourceKey=**/tests/**
# RCS1251 in tests: record brace style is preference, not a defect (78 issues, 0 in src)
sonar.issue.ignore.multicriteria.t4.ruleKey=external_roslyn:RCS1251
sonar.issue.ignore.multicriteria.t4.resourceKey=**/tests/**
# IDE0060 in tests: unused params in test fakes (overlaps RCS1163)
sonar.issue.ignore.multicriteria.t5.ruleKey=external_roslyn:IDE0060
sonar.issue.ignore.multicriteria.t5.resourceKey=**/tests/**
# RCS1261 in tests: resource disposal style (49 issues, 0 in src)
sonar.issue.ignore.multicriteria.t6.ruleKey=external_roslyn:RCS1261
sonar.issue.ignore.multicriteria.t6.resourceKey=**/tests/**
# CA2016 in tests: CancellationToken forwarding in test code (46 issues, 0 in src)
sonar.issue.ignore.multicriteria.t7.ruleKey=external_roslyn:CA2016
sonar.issue.ignore.multicriteria.t7.resourceKey=**/tests/**
# CA1873 in tests: string.StartsWith char overload (26 issues, 0 in src)
sonar.issue.ignore.multicriteria.t8.ruleKey=external_roslyn:CA1873
sonar.issue.ignore.multicriteria.t8.resourceKey=**/tests/**

# S2326 in marker interfaces: type params exist for source generator scanning, already pragma-suppressed
sonar.issue.ignore.multicriteria.s1.ruleKey=csharpsquid:S2326
sonar.issue.ignore.multicriteria.s1.resourceKey=**/IPerspectiveBase.cs,**/IScopedMultiLensAccess.cs,**/IGlobalPerspectiveFor.cs,**/ITemporalPerspectiveFor.cs,**/IPerspectiveWithActionsFor.cs,**/IPerspectiveFor.cs,**/CommandEndpointAttribute.cs
# S2436 too many type parameters: intentional — generic type params are fundamental to framework API
sonar.issue.ignore.multicriteria.s2.ruleKey=csharpsquid:S2436
sonar.issue.ignore.multicriteria.s2.resourceKey=**/*
# CA1707 in tests: BDD-style test names intentionally use underscores (Method_Condition_Result)
sonar.issue.ignore.multicriteria.s3.ruleKey=external_roslyn:CA1707
sonar.issue.ignore.multicriteria.s3.resourceKey=**/tests/**
# WHIZ informational diagnostics from source generators (not code quality issues)
sonar.issue.ignore.multicriteria.s4.ruleKey=external_roslyn:WHIZ*
sonar.issue.ignore.multicriteria.s4.resourceKey=**/*
# EFCORE informational diagnostics from EF Core source generators
sonar.issue.ignore.multicriteria.s5.ruleKey=external_roslyn:EFCORE*
sonar.issue.ignore.multicriteria.s5.resourceKey=**/*

# S107 too many parameters: constructors use DI injection — many parameters are idiomatic.
# SonarQube cannot filter by "constructors only", so actual suppression is via #pragma in source files.
# This entry suppresses any remaining S107 in tests (test fakes with many constructor params).
sonar.issue.ignore.multicriteria.s6.ruleKey=csharpsquid:S107
sonar.issue.ignore.multicriteria.s6.resourceKey=**/tests/**

# NOTE: S2077 false positives on the DLQ services (schema-qualified SQL identifier interpolation) are
# suppressed IN CODE via [SuppressMessage] on the classes, not here — SonarCloud does not apply
# sonar.issue.ignore.multicriteria to security-type issues (VULNERABILITY), only to code smells.

# Coverage exclusions (not measured for coverage — only test/tool/sample/generator code)
#
# **/*.sql: the coverage report is produced by the .NET test runs and covers C# only — nothing in
# this repo instruments PL/pgSQL. Sonar's plsql analyser still counts executable statements inside
# migration function bodies as lines-to-cover, so every migration lands as permanently-0%-covered
# lines that no test can ever earn back: repo-wide the Migrations directory sits at 0% over 35
# such lines, and a single large migration can drag a whole PR's new-code coverage under the gate
# regardless of how well its C# is tested. Excluding them measures what is actually measurable.
# This is coverage-only — `sonar.exclusions` deliberately does NOT list *.sql, so the migrations
# are still analysed for issues, and they remain covered behaviourally by real-Postgres
# integration tests (see tests/**/…SqlTests.cs).
sonar.coverage.exclusions=**/samples/**,**/benchmarks/**,**/tests/**,**/tools/**,src/Whizbang.Generators/**,src/Whizbang.Generators.Shared/**,src/Whizbang.Data.EFCore.Postgres.Generators/**,src/Whizbang.Transports.HotChocolate.Generators/**,src/Whizbang.Transports.FastEndpoints.Generators/**,src/Whizbang.Sagas.Generators/**,**/scripts/**,**/*.sql
